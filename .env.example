# Spring 게이트웨이 API base URL
# 개발: vite proxy 기본 활성화로 `/api/*` 가 자동 포워딩되므로 비워둬도 됨
# 배포: 절대 URL 지정 (예: https://api.qapilot.example.com)
VITE_API_BASE_URL=

# ── 로컬 개발 가이드 ─────────────────────────────────────────────────────
# Spring 게이트웨이를 dev 프로필로 띄우면 admin 계정이 자동 시드된다.
#   qapilot-server $ ./gradlew bootRun --args="--spring.profiles.active=dev"
# UI 로그인 시 다음 자격증명을 사용:
#   email:    admin@qapilot.com
#   password: admin1234
# Spring 미기동 상태에서는 UI 로그인 불가 (Phase B 의 dev bypass 가 제거됨).
